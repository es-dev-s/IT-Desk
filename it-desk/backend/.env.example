# Copy to backend/.env (gitignored) and fill in real values. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SCHEMA=itdesk
# `make run`/`make dev` override this with 127.0.0.1:8080: the API is only reached
# through the web server's /api proxy, so it never has to be exposed on the LAN.
HTTP_ADDR=:8080
APP_ENV=development
# Browser origins allowed to call the API (Origin/CSRF guard + CORS). ALLOWED_ORIGINS
# wins over the older CORS_ALLOWED_ORIGINS name.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# auto (default outside production): also allow http://<this machine's LAN IP>:WEB_PORT,
# detected at start-up (Docker/libvirt/VM bridges are ignored). off = only the list above.
LAN_ORIGINS=auto
WEB_PORT=3000
DB_MAX_CONNS=10
DB_MIN_CONNS=1
# 0 = keep retrying forever in the background (the server stays up and returns 503 until ready)
DB_CONNECT_RETRIES=0
DB_STATEMENT_TIMEOUT=5s
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s
UNDO_WINDOW=10m
# Floor layouts are read-only (no builder edits, new floors or publishing). Set false to sketch layouts again.
FLOOR_LAYOUT_LOCKED=true
MIGRATE_ON_START=true
LOG_LEVEL=info
LOG_FORMAT=text

# --- Authentication -------------------------------------------------------
# Sessions: opaque HttpOnly cookie, absolute lifetime + idle timeout.
SESSION_TTL=168h
SESSION_IDLE_TIMEOUT=12h
# Secure cookies are forced on when APP_ENV=production. Leave unset in local dev (http).
# COOKIE_SECURE=true
# Rate limiting / lockout key on the client IP. X-Forwarded-For is honoured only from
# these peers (CIDRs or IPs; default loopback = the web server's /api proxy), right-most
# untrusted entry wins, so clients cannot spoof it.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Legacy: trust the left-most X-Forwarded-For from ANY peer. Leave false.
TRUST_PROXY=false
# Optional bootstrap admin, created once at API start if that email doesn't exist.
# Prefer `go run ./cmd/seed --create-admin` and keep these empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=IT-Desk Admin
